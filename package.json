{
  "name": "dsh-global-search",
  "version": "1.0.0",
  "description": "Global full-text search across every session workspace, in a sidebar panel.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "search",
    "sessions",
    "full-text",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as1164/dsh-global-search.git"
  },
  "homepage": "https://github.com/as1164/dsh-global-search#readme",
  "bugs": {
    "url": "https://github.com/as1164/dsh-global-search/issues"
  },
  "author": "as1164"
}
